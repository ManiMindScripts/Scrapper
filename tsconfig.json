{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "csv-writer": ["./src/types/csv-writer.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
